# Maintainer: JasonLandbridge
# Packaging repository: https://github.com/JasonLandbridge/Arch-Linux-AUR-Packages-Updater/tree/main/proc

pkgname=proc
pkgver=2.5.0 # renovate: datasource=github-releases depName=yazeed/proc-cli versioning=semver-coerced
pkgrel=1
pkgdesc="Semantic CLI tool for process management. Target by port, PID, name or path."
arch=('x86_64' 'aarch64')
url="https://github.com/yazeed/proc-cli"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
provides=('proc')
options=('!lto' '!strip')

source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('10e7056309191d2a65e7b39f77d1e89c2e35f70cf5c9c970ac5cddef3ef48450')

prepare() {
  cd "${srcdir}/proc-cli-${pkgver}"
  cargo fetch --locked --target "${CARCH}-unknown-linux-gnu"
}

build() {
  cd "${srcdir}/proc-cli-${pkgver}"
  cargo build --frozen --release
}

package() {
  cd "${srcdir}/proc-cli-${pkgver}"

  install -Dm755 "target/release/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
