{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "at any time"
  ],
  "automergeSchedule": [
    "at any time"
  ],
  "dependencyDashboardApproval": false,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "renovatebot/github-action"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "dependencyDashboardApproval": false,
      "minimumReleaseAge": "0 days",
      "internalChecksFilter": "strict",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "schedule": [
        "at any time"
      ],
      "automergeSchedule": [
        "at any time"
      ],
      "separateMajorMinor": true,
      "separateMultipleMajor": true,
      "separateMultipleMinor": true
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "Reaparr/Reaparr"
      ],
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "matchDatasources": [
        "custom.chrome-for-testing"
      ],
      "postUpgradeTasks": {
        "commands": [
          "bash .github/scripts/renovate-refresh-aur-package.sh {{{packageFileDir}}}"
        ],
        "fileFilters": [
          "{{{packageFileDir}}}/PKGBUILD",
          "{{{packageFileDir}}}/.SRCINFO"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "customDatasources": {
    "chrome-for-testing": {
      "defaultRegistryUrlTemplate": "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json",
      "format": "json",
      "transformTemplates": [
        "$exists(channels.Stable.version) and $exists(channels.Stable.downloads.chrome[platform = 'linux64'].url) ? {\"releases\":[{\"version\":channels.Stable.version,\"isStable\":true}],\"sourceUrl\":\"https://github.com/GoogleChromeLabs/chrome-for-testing\",\"homepage\":\"https://googlechromelabs.github.io/chrome-for-testing/\"} : {\"releases\":[]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)PKGBUILD$/"
      ],
      "matchStrings": [
        "pkgver=(?<currentValue>\\S+) # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>.*))?\\npkgrel=\\S+"
      ],
      "currentValueTemplate": "{{{replace '_' '-' currentValue}}}",
      "autoReplaceStringTemplate": "pkgver={{{replace '-' '_' newValue}}} # renovate: datasource={{{datasource}}} depName={{{depName}}}{{#if versioning}} versioning={{{versioning}}}{{/if}}{{#if extractVersion}} extractVersion={{{extractVersion}}}{{/if}}\npkgrel=1"
    }
  ]
}
