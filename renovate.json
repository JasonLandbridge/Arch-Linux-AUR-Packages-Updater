{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "at any time"
  ],
  "automergeSchedule": [
    "at any time"
  ],
  "dependencyDashboardApproval": false,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "renovatebot/github-action"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "dependencyDashboardApproval": false,
      "minimumReleaseAge": "0 days",
      "internalChecksFilter": "strict",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "schedule": [
        "at any time"
      ],
      "automergeSchedule": [
        "at any time"
      ],
      "separateMajorMinor": true,
      "separateMultipleMajor": true,
      "separateMultipleMinor": true
    },
    {
      "matchDepNames": [
        "JasonLandbridge/superset"
      ],
      "extractVersionTemplate": "^desktop-v(?<version>.*)$"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)PKGBUILD$/"
      ],
      "matchStrings": [
        "pkgver=(?<currentValue>.*) # renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>.*))?"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}
